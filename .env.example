# ==========================================
# SliceFlow - Environment Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection
# If left empty, SliceFlow will automatically launch an in-memory MongoDB Replica Set with full ACID transaction support!
MONGODB_URI=

# JWT Secrets
JWT_SECRET=sliceflow_super_secure_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
COOKIE_SECRET=sliceflow_cookie_signing_secret_key

# Razorpay Test Mode Credentials
# Required for actual Razorpay Checkout integration
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_secret_do_not_commit

# Default Administrator Credentials (used by seed script)
ADMIN_NAME=SliceFlow Master Admin
ADMIN_EMAIL=admin@sliceflow.com
ADMIN_PASSWORD=AdminSecurePassword123!

# Email Service (Nodemailer)
# If left empty, development-mode mock email logging is cleanly enabled.
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=no-reply@sliceflow.com

# Low-Stock Thresholds
DEFAULT_LOW_STOCK_THRESHOLD=20
ADMIN_ALERT_EMAIL=admin@sliceflow.com

